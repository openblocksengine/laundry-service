# ============================================================
# .gitignore — Service Laundry (Monorepo: Flask + Vite/React)
# Strict rules to keep secrets & artifacts out of GitHub
# ============================================================

# ========================
#  ENVIRONMENT / SECRETS
# ========================
# NEVER commit secrets — block every possible .env variant
.env
.env.*
!.env.example
*.local

# ========================
#  PYTHON — Backend
# ========================
# Virtual environments
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.so

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# PyInstaller
*.manifest
*.spec

# Installer logs
pip-log.txt
pip-delete-this-directory.txt

# Unit test / coverage reports
htmlcov/
.tox/
.nox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/
.pytest_cache/
cover/

# Flask / instance folder
instance/
.webassets-cache

# Type checkers
.mypy_cache/
.dmypy.json
dmypy.json
.pyre/
.pytype/
cython_debug/

# Celery
celerybeat-schedule
celerybeat.pid

# ========================
#  NODE.JS — Frontend
# ========================
node_modules/
.pnp/
.pnp.js

# Package manager logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Vite build output
dist/
dist-ssr/

# ========================
#  LOGS
# ========================
logs/
*.log

# ========================
#  DATABASE DUMPS
# ========================
# Prevent accidental commit of large SQL dumps
# (remove these lines if you intentionally want to track them)
# *.sql

# ========================
#  OS GENERATED FILES
# ========================
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
Desktop.ini
$RECYCLE.BIN/
*.cab
*.msi
*.msix
*.msm
*.msp
*.lnk

# Linux
*~
.directory

# ========================
#  EDITORS / IDEs
# ========================
# VS Code
.vscode/
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# JetBrains (PyCharm, WebStorm, etc.)
.idea/
*.iml
*.iws
*.ipr
out/

# Vim / Neovim
*.swp
*.swo
*.swn
*~
Session.vim
.netrwhist
tags

# Sublime Text
*.sublime-project
*.sublime-workspace

# ========================
#  MISC
# ========================
# Dependency lock debugging
*.tsbuildinfo

# Sentry
.sentryrc
.sentryclirc

# Vercel (auto-generated)
.vercel

# Docker
docker-compose.override.yml
